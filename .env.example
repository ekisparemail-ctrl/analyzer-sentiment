# Kafka
KAFKA_BOOTSTRAP_SERVERS=172.16.16.100:21000
# Confirmed against the Scrapper Backend's real source (application.yml) -- do
# not change unless the Scrapper Backend's own config changes. Merged from
# separate post/comment topics into this single one.
KAFKA_SCRAPPER_TOPIC=scrapper-to-analysis
# Name finalized on our side; still pending devops provisioning it on the
# broker (spec section 9) -- hand-off note for devops: "please create Kafka
# topic analysis-to-scrapper on 172.16.16.100:21000, same conventions as
# scrapper-to-analysis."
KAFKA_RESULT_TOPIC=analysis-to-scrapper
KAFKA_CONSUMER_GROUP=analytics-backend

# LLM (LM Studio, OpenAI-compatible)
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=replace-with-lm-studio-model-name

# VLM - remote HTTP call again (revision 1), the same LM Studio instance
# already serving LLM_BASE_URL/LLM_MODEL above, but kept as its own config
# entry so the two can diverge later without a code change.
VLM_BASE_URL=http://172.16.16.101:1234/v1
VLM_MODEL=qwen3-vl-8b-instruct-mlx

# Video analyzer (local ffmpeg frame extraction + faster-whisper transcription
# + the in-process VLM above for the video summary)
WHISPER_MODEL_SIZE=base
# Filters out non-speech audio (e.g. music-only segments) before
# transcription -- reduces faster-whisper hallucinating text over such
# segments. Set to false if it turns out too aggressive (e.g. drops quiet
# speech) for a given batch of content.
WHISPER_VAD_FILTER=true
# Main lever over VLM response time on CPU-only inference -- every frame is
# encoded before generation can start. A real ~30s TikTok clip at 32 frames
# took over 20 minutes end to end. Lower = faster but coarser video
# understanding; raise it back up once real latency (and, per spec section 9,
# whether a GPU becomes viable) is better understood.
MAX_FRAMES=8
# Grayscale mean-absolute-difference a candidate frame must exceed vs. the
# previous *kept* candidate to be considered a keyframe. video-analyzer
# hardcodes this at 10.0 and never actually reads its own
# analysis_threshold/min_difference config keys -- keeping this configurable
# avoids repeating that bug.
KEYFRAME_DIFF_THRESHOLD=10.0
MAX_TOKENS=500

# Adds `-hwaccel cuda -hwaccel_output_format cuda` to the ffmpeg decode
# invocation (video/frames.py) when true. Off by default -- this deployment
# has no NVIDIA GPU to test it against; exists for whichever machine runs
# this with one.
FFMPEG_HWACCEL_CUDA=false

# When true, keyframes are grouped into batches of VLM_BATCH_SIZE and sent
# as separate multi-image VLM calls; when false, every keyframe goes into
# its own call instead.
VLM_BATCH_ENABLED=true
# Keyframes per batch when VLM_BATCH_ENABLED is true; ignored otherwise.
# Starting default balances per-call payload size against round trips to
# the Mac Studio -- not measured yet.
VLM_BATCH_SIZE=4

# HTTP client behavior
HTTP_TIMEOUT_SECONDS=30
RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=1

# Dev-only: also write each processed item's final AnalysisResult to a local
# JSON file, in addition to publishing it to Kafka as before. Defaults on
# per the directive's explicit ask; reconsider before a real production
# rollout (unbounded local disk growth, one file per item forever).
DEV_DUMP_OUTPUT=true
